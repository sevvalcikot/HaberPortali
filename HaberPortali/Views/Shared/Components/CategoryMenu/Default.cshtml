@model List<Category>
@{
    var currentSlug = ViewContext.RouteData.Values["slug"]?.ToString();
    var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
                 && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}
<ul class="main-nav-list">
    <li><a href="/" class="@(isHome ? "active" : "")"><i class="bi bi-house-door"></i> Ana sayfa</a></li>
    @foreach (var category in Model)
    {
        <li><a href="/kategori/@category.Slug" class="@(currentSlug == category.Slug ? "active" : "")">@category.Name</a></li>
    }
</ul>
