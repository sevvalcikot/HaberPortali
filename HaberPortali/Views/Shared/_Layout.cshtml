<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? title + " · HaberPortalı" : "HaberPortalı · Güncel haberler")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Gündem, ekonomi, spor, teknoloji ve daha fazlası. Güncel haberler HaberPortalı'nda.")" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="site-header">
        <div class="topbar">
            <div class="container d-flex align-items-center gap-3">
                <span class="d-none d-sm-inline"><i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("d MMMM yyyy, dddd")</span>
                <nav class="ms-auto d-flex gap-3 align-items-center">
                    <a asp-controller="Home" asp-action="About">Hakkımızda</a>
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Editor)))
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Yönetim paneli</a>
                    }
                    else
                    {
                        <a asp-area="Admin" asp-controller="Account" asp-action="Login"><i class="bi bi-person me-1"></i>Editör girişi</a>
                    }
                </nav>
            </div>
        </div>

        <div class="masthead">
            <div class="container d-flex align-items-center gap-3">
                <a class="logo" asp-controller="Home" asp-action="Index">
                    <span class="logo-mark">H</span>
                    <span class="logo-text">Haber<span>Portalı</span></span>
                </a>
                <form class="site-search ms-auto" action="/ara" method="get" role="search">
                    <input type="search" name="q" class="form-control" placeholder="Haberlerde ara…" aria-label="Haberlerde ara" value="@Context.Request.Query["q"]" />
                    <button type="submit" aria-label="Ara"><i class="bi bi-search"></i></button>
                </form>
                <button class="btn btn-outline-dark d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menü">
                    <i class="bi bi-list"></i>
                </button>
            </div>
        </div>

        <nav class="main-nav">
            <div class="container">
                <div class="collapse d-lg-block" id="mainNav">
                    @await Component.InvokeAsync("CategoryMenu", new { view = "Default" })
                </div>
            </div>
        </nav>

        @await Component.InvokeAsync("BreakingNews")
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <a class="logo logo-light" asp-controller="Home" asp-action="Index">
                        <span class="logo-mark">H</span>
                        <span class="logo-text">Haber<span>Portalı</span></span>
                    </a>
                    <p class="mt-3 mb-0 small">Gündemden ekonomiye, spordan teknolojiye; doğrulanmış ve tarafsız haberler.</p>
                </div>
                <div class="col-md-4">
                    <h3 class="footer-title">Kategoriler</h3>
                    @await Component.InvokeAsync("CategoryMenu", new { view = "Footer" })
                </div>
                <div class="col-md-3">
                    <h3 class="footer-title">Kurumsal</h3>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                        <li><a asp-area="Admin" asp-controller="Account" asp-action="Login">Editör girişi</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">© @DateTime.Now.Year HaberPortalı. Tüm hakları saklıdır.</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
