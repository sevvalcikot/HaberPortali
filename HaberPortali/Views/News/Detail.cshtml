@model NewsDetailViewModel
@{
    var news = Model.News;
    ViewData["Title"] = news.Title;
    ViewData["Description"] = news.Summary;
    var shareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/haber/{news.Id}/{news.Slug}";
}

<div class="row g-5">
    <article class="col-lg-8 article">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="/">Ana sayfa</a></li>
                <li class="breadcrumb-item"><a href="/kategori/@news.Category.Slug">@news.Category.Name</a></li>
            </ol>
        </nav>

        @if (news.IsBreaking)
        {
            <span class="badge-breaking badge-inline mb-2">Son dakika</span>
        }
        <h1 class="article-title">@news.Title</h1>
        <p class="article-summary">@news.Summary</p>

        <div class="article-meta">
            <span><i class="bi bi-person"></i> @news.Author.FullName</span>
            <span><i class="bi bi-calendar3"></i> @news.PublishedAt.ToString("d MMMM yyyy, HH:mm")</span>
            @if (news.UpdatedAt.HasValue)
            {
                <span><i class="bi bi-arrow-repeat"></i> Güncelleme: @news.UpdatedAt.Value.ToString("d MMMM, HH:mm")</span>
            }
            <span><i class="bi bi-eye"></i> @news.ViewCount.ToString("N0") okunma</span>
        </div>

        @if (!string.IsNullOrEmpty(news.ImagePath))
        {
            <figure class="article-figure">
                <img src="@news.ImagePath" alt="@news.Title" />
            </figure>
        }

        <div class="article-body">
            @foreach (var paragraph in TextHelper.ToParagraphs(news.Content))
            {
                <p>@paragraph</p>
            }
        </div>

        @if (news.NewsTags.Any())
        {
            <div class="article-tags">
                @foreach (var newsTag in news.NewsTags.OrderBy(nt => nt.Tag.Name))
                {
                    <a href="/etiket/@newsTag.Tag.Slug">#@newsTag.Tag.Name</a>
                }
            </div>
        }

        <div class="article-share">
            <span class="small text-muted me-2">Paylaş:</span>
            <a class="btn btn-sm btn-outline-dark" target="_blank" rel="noopener" href="https://x.com/intent/post?url=@Uri.EscapeDataString(shareUrl)&text=@Uri.EscapeDataString(news.Title)" aria-label="X'te paylaş"><i class="bi bi-twitter-x"></i></a>
            <a class="btn btn-sm btn-outline-dark" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(shareUrl)" aria-label="Facebook'ta paylaş"><i class="bi bi-facebook"></i></a>
            <a class="btn btn-sm btn-outline-dark" target="_blank" rel="noopener" href="https://wa.me/?text=@Uri.EscapeDataString(news.Title + " " + shareUrl)" aria-label="WhatsApp'ta paylaş"><i class="bi bi-whatsapp"></i></a>
            <button type="button" class="btn btn-sm btn-outline-dark js-copy-link" data-url="@shareUrl"><i class="bi bi-link-45deg"></i> Bağlantıyı kopyala</button>
        </div>

        <section class="comments" id="yorumlar">
            <h2 class="section-title"><span>Yorumlar (@Model.Comments.Count)</span></h2>

            @foreach (var comment in Model.Comments)
            {
                <div class="comment">
                    <span class="avatar">@comment.User.FullName.Substring(0, 1)</span>
                    <div>
                        <div class="comment-head"><strong>@comment.User.FullName</strong> <span class="meta">@TextHelper.TimeAgo(comment.CreatedAt)</span></div>
                        <p class="mb-0">@comment.Text</p>
                    </div>
                </div>
            }

            @if (!Model.Comments.Any())
            {
                <p class="text-muted">Bu habere henüz yorum yapılmamış.</p>
            }

            <div class="comment-login-hint">
                <i class="bi bi-info-circle"></i> Yorum yapabilmek için üye girişi yakında açılacak.
            </div>
        </section>

        @if (Model.Related.Any())
        {
            <section class="mt-5">
                <h2 class="section-title"><span>İlgili haberler</span></h2>
                <div class="row g-4">
                    @foreach (var item in Model.Related)
                    {
                        <div class="col-md-4">
                            <partial name="_NewsCard" model="item" />
                        </div>
                    }
                </div>
            </section>
        }
    </article>

    <aside class="col-lg-4">
        <div class="sticky-lg-top" style="top: 1rem;">
            <partial name="_MostRead" model="Model.MostRead" />
        </div>
    </aside>
</div>
